ight":344,"hotspot":22,"type":25,"uid":625,"url":626,"width":612},"We implement","27369205547f","\u002Fcdn.sanity.io\u002Fimages\u002F535lnz3g\u002Fproduction\u002F6c9ebc51108f425c4888cf320e2698cf7a713f38-1054x600.jpg",{"_type":628,"title":629},"lowerTagline","Made to last, designed to endure."]